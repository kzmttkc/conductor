# Supabase (leave empty to use local Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Set to your Vercel URL in production (used for OG metadata + Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true for public /demo (no signup). Set false only with real Supabase Auth.
NEXT_PUBLIC_DEMO_MODE=true

# Real LLM agent runtime (optional — without keys, structured runtime + web search still runs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional higher-quality search
TAVILY_API_KEY=

# Inngest (optional in demo mode)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
